            function publishArticleObject(rawArt) {
                // Quitar marca de 'nueva' a las anteriores
                for (var i = 0; i < articles.length; i++) {
                    articles[i].isNew = false;
                }
                var now = new Date();
                var hh = String(now.getHours()).padStart(2, "0");
                var mm = String(now.getMinutes()).padStart(2, "0");

                var published = {
                    id: rawArt.id || Date.now(),
                    category: rawArt.category,
                    title: rawArt.title,
                    excerpt: rawArt.excerpt,
                    author: rawArt.author || "Por Redacción Automática",
                    readTime: rawArt.readTime || "3 min de lectura",
                    timeLabel: "Publicada a las " + hh + ":" + mm,
                    isNew: true,
                    grandpaQuote: rawArt.grandpaQuote || "Informarse con calma ayuda a tomar mejores decisiones cada día.",
                    paragraphs: rawArt.paragraphs || [rawArt.excerpt]
                };

                articles.unshift(published);
                secondsLeft = INTERVAL_SEC;
                updateCountdownUI();
                renderPortal();
                renderQueueList();
                showToast(published.title, published.id);
            }

            function updateCountdownUI() {
                var el = document.getElementById("countdown-seconds");
                if (el) el.textContent = secondsLeft + "s";
            }

            function startAutoTimer() {
                if (timerHandle) clearInterval(timerHandle);
                timerHandle = setInterval(function () {
                    if (!isAutoRunning) return;
                    secondsLeft--;
                    if (secondsLeft <= 0) {
                        window.publishNextNow();
                    } else {
                        updateCountdownUI();
                    }
                }, 1000);
            }

