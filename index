<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Las Noticias del Abuelo — Edición Digital Automática</title>
    <style>
        /* =========================================================
           1. VARIABLES DE DISEÑO EDITORIAL Y RESET
           ========================================================= */
        :root {
            --paper-bg: #FAF7F2;
            --paper-card: #FFFFFF;
            --paper-alt: #F3EDE2;
            --border-color: #DED5C5;
            --border-strong: #1A1A1A;
            --ink-main: #1A1A1A;
            --ink-muted: #55514B;
            --ink-light: #767169;
            --burgundy: #8B1E24;
            --burgundy-dark: #681318;
            --gold: #B7791F;
            --green-live: #15803D;
            --font-serif: Georgia, 'Times New Roman', Times, serif;
            --font-sans: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            --shadow-sm: 0 2px 6px rgba(26, 26, 26, 0.06);
            --shadow-md: 0 8px 20px rgba(26, 26, 26, 0.10);
            --shadow-lg: 0 16px 36px rgba(26, 26, 26, 0.18);
            --radius-md: 12px;
            --radius-lg: 16px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--paper-bg);
            color: var(--ink-main);
            font-family: var(--font-sans);
            line-height: 1.55;
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        button, input, select, textarea {
            font-family: inherit;
        }

        .container {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 16px;
        }

        /* =========================================================
           2. BARRA SUPERIOR EN VIVO Y CONTROL DE AUTO-PUBLICACIÓN
           ========================================================= */
        .top-live-bar {
            background-color: var(--ink-main);
            color: #FAF7F2;
            font-size: 0.82rem;
            border-bottom: 2px solid var(--burgundy);
        }

        .top-live-inner {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 8px 16px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .live-meta {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px;
            color: #E5DFD3;
        }

        .live-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background-color: rgba(21, 128, 61, 0.25);
            border: 1px solid #22C55E;
            color: #86EFAC;
            font-weight: 700;
            font-size: 0.72rem;
            padding: 3px 10px;
            border-radius: 999px;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .live-badge.paused {
            background-color: rgba(183, 121, 31, 0.25);
            border-color: #F59E0B;
            color: #FDE68A;
        }

        .pulse-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #22C55E;
            animation: pulseAnim 1.5s infinite;
        }

        .live-badge.paused .pulse-dot {
            background-color: #F59E0B;
            animation: none;
        }

        @keyframes pulseAnim {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(0.8); }
        }

        .auto-controls {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
        }

        .countdown-box {
            background-color: #2B2A27;
            border: 1px solid #44403C;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 0.78rem;
            font-weight: 600;
        }

        .countdown-box strong {
            color: #FBBF24;
        }

        .btn-top {
            border: none;
            border-radius: 999px;
            padding: 6px 12px;
            font-size: 0.78rem;
            font-weight: 700;
            cursor: pointer;
            transition: transform 0.15s ease, background-color 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .btn-top:active {
            transform: scale(0.97);
        }

        .btn-publish-now {
            background-color: var(--burgundy);
            color: #FFFFFF;
        }

        .btn-publish-now:hover {
            background-color: #A6242B;
        }

        .btn-pause {
            background-color: #363430;
            color: #FAF7F2;
            border: 1px solid #524E48;
        }

        .btn-pause:hover {
            background-color: #4A4640;
        }

        /* =========================================================
           3. CABECERA TIPO PERIÓDICO CLÁSICO ARGENTINO
           ========================================================= */
        .masthead {
            background-color: var(--paper-bg);
            padding: 20px 0 12px;
            border-bottom: 1px solid var(--border-color);
        }

        .masthead-grid {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding-bottom: 14px;
            border-bottom: 3px double var(--border-strong);
        }

        .edition-info {
            font-size: 0.78rem;
            color: var(--ink-muted);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .brand-center {
            text-align: center;
            flex: 1 1 320px;
        }

        .brand-kicker {
            font-size: 0.74rem;
            text-transform: uppercase;
            letter-spacing: 0.18em;
            color: var(--burgundy);
            font-weight: 800;
            margin-bottom: 4px;
        }

        .brand-title {
            font-family: var(--font-serif);
            font-size: clamp(2.1rem, 5vw, 3.6rem);
            font-weight: 900;
            letter-spacing: -0.02em;
            line-height: 1.05;
            color: var(--ink-main);
        }

        .brand-subtitle {
            font-family: var(--font-serif);
            font-style: italic;
            font-size: 0.95rem;
            color: var(--ink-muted);
            margin-top: 4px;
        }

        .masthead-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-editorial {
            background-color: var(--paper-card);
            color: var(--ink-main);
            border: 1px solid var(--border-strong);
            padding: 8px 14px;
            border-radius: 999px;
            font-size: 0.82rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .btn-editorial:hover {
            background-color: var(--ink-main);
            color: var(--paper-bg);
        }

        .badge-count {
            background-color: var(--burgundy);
            color: #FFFFFF;
            font-size: 0.72rem;
            padding: 1px 7px;
            border-radius: 999px;
        }

        /* =========================================================
           4. TICKER DE ÚLTIMO MOMENTO
           ========================================================= */
        .ticker-bar {
            background-color: var(--burgundy);
            color: #FFFFFF;
            display: flex;
            align-items: center;
            overflow: hidden;
            border-bottom: 2px solid var(--burgundy-dark);
        }

        .ticker-label {
            background-color: var(--burgundy-dark);
            padding: 8px 14px;
            font-size: 0.75rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            white-space: nowrap;
            z-index: 2;
        }

        .ticker-track-wrap {
            overflow: hidden;
            flex: 1;
            padding: 7px 12px;
        }

        .ticker-text {
            font-size: 0.86rem;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            cursor: pointer;
        }

        .ticker-text:hover {
            text-decoration: underline;
        }

        /* =========================================================
           5. NAVEGACIÓN DE CATEGORÍAS Y BUSCADOR
           ========================================================= */
        .nav-section {
            background-color: var(--paper-alt);
            border-bottom: 1px solid var(--border-color);
            padding: 12px 0;
            position: sticky;
            top: 0;
            z-index: 20;
        }

        .nav-flex {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .category-tabs {
            display: flex;
            align-items: center;
            gap: 8px;
            overflow-x: auto;
            padding-bottom: 2px;
            max-width: 100%;
        }

        .cat-tab {
            background-color: var(--paper-card);
            color: var(--ink-main);
            border: 1px solid var(--border-color);
            padding: 7px 14px;
            border-radius: 999px;
            font-size: 0.84rem;
            font-weight: 700;
            white-space: nowrap;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s ease;
        }

        .cat-tab:hover {
            border-color: var(--ink-main);
        }

        .cat-tab.active {
            background-color: var(--ink-main);
            color: #FFFFFF;
            border-color: var(--ink-main);
        }

        .cat-tab .tab-num {
            background-color: rgba(0, 0, 0, 0.08);
            padding: 1px 7px;
            border-radius: 999px;
            font-size: 0.74rem;
        }

        .cat-tab.active .tab-num {
            background-color: rgba(255, 255, 255, 0.22);
            color: #FFFFFF;
        }

        .search-box {
            display: flex;
            align-items: center;
            background-color: var(--paper-card);
            border: 1px solid var(--border-color);
            border-radius: 999px;
            padding: 5px 12px;
            min-width: 220px;
        }

        .search-box input {
            border: none;
            background: transparent;
            outline: none;
            font-size: 0.85rem;
            color: var(--ink-main);
            width: 100%;
        }

        /* =========================================================
           6. PORTADA PRINCIPAL (HERO DESTACADO)
           ========================================================= */
        .main-content {
            padding: 24px 0 48px;
        }

        .hero-card {
            background-color: var(--paper-card);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-md);
            overflow: hidden;
            display: grid;
            grid-template-columns: 1.15fr 1fr;
            margin-bottom: 32px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .hero-card:hover {
            box-shadow: var(--shadow-lg);
        }

        .hero-art {
            position: relative;
            min-height: 280px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .hero-art svg {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
        }

        .hero-badges {
            position: absolute;
            top: 14px;
            left: 14px;
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .hero-body {
            padding: 26px 28px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 16px;
        }

        .hero-kicker {
            font-size: 0.78rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--burgundy);
        }

        .hero-title {
            font-family: var(--font-serif);
            font-size: clamp(1.5rem, 2.8vw, 2.2rem);
            font-weight: 800;
            line-height: 1.18;
            color: var(--ink-main);
            margin: 8px 0 12px;
        }

        .hero-excerpt {
            font-size: 1rem;
            color: var(--ink-muted);
            line-height: 1.6;
        }

        .grandpa-quote {
            background-color: var(--paper-alt);
            border-left: 4px solid var(--gold);
            padding: 10px 14px;
            border-radius: 0 8px 8px 0;
            font-family: var(--font-serif);
            font-style: italic;
            font-size: 0.9rem;
            color: var(--ink-main);
        }

        .card-footer-row {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding-top: 12px;
            border-top: 1px solid var(--border-color);
            font-size: 0.8rem;
            color: var(--ink-light);
        }

        .btn-read {
            background-color: var(--ink-main);
            color: #FFFFFF;
            border: none;
            padding: 9px 16px;
            border-radius: 999px;
            font-size: 0.84rem;
            font-weight: 700;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

        .btn-read:hover {
            background-color: var(--burgundy);
        }

        /* =========================================================
           7. GRILLA DE NOTICIAS Y TARJETAS
           ========================================================= */
        .section-header {
            display: flex;
            flex-wrap: wrap;
            align-items: baseline;
            justify-content: space-between;
            gap: 8px;
            border-bottom: 2px solid var(--border-strong);
            padding-bottom: 8px;
            margin-bottom: 20px;
        }

        .section-title {
            font-family: var(--font-serif);
            font-size: 1.5rem;
            font-weight: 800;
        }

        .news-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
            gap: 22px;
        }

        .news-card {
            background-color: var(--paper-card);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .news-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-md);
        }

        .news-card.is-new-anim {
            animation: cardSlideIn 0.55s ease-out;
            border-color: var(--burgundy);
            box-shadow: 0 0 0 2px rgba(139, 30, 36, 0.22);
        }

        @keyframes cardSlideIn {
            from { opacity: 0; transform: translateY(-14px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .card-art {
            position: relative;
            height: 165px;
            overflow: hidden;
        }

        .card-art svg {
            width: 100%;
            height: 100%;
            display: block;
        }

        .card-badges {
            position: absolute;
            top: 10px;
            left: 10px;
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        .cat-pill {
            font-size: 0.7rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            padding: 4px 10px;
            border-radius: 999px;
            color: #FFFFFF;
            box-shadow: 0 2px 6px rgba(0,0,0,0.25);
        }

        .pill-argentina { background-color: #0369A1; }
        .pill-internacional { background-color: #4338CA; }
        .pill-economia { background-color: #047857; }
        .pill-tecnologia { background-color: #334155; }
        .pill-deportes { background-color: #B45309; }

        .new-pill {
            background-color: #15803D;
            color: #FFFFFF;
            font-size: 0.7rem;
            font-weight: 800;
            padding: 4px 10px;
            border-radius: 999px;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .card-body {
            padding: 18px;
            display: flex;
            flex-direction: column;
            flex: 1;
            justify-content: space-between;
            gap: 14px;
        }

        .card-meta-top {
            font-size: 0.76rem;
            color: var(--ink-light);
            font-weight: 600;
            margin-bottom: 6px;
        }

        .card-title {
            font-family: var(--font-serif);
            font-size: 1.22rem;
            font-weight: 800;
            line-height: 1.28;
            color: var(--ink-main);
            margin-bottom: 8px;
        }

        .card-excerpt {
            font-size: 0.9rem;
            color: var(--ink-muted);
            line-height: 1.5;
        }

        /* =========================================================
           8. MODALES (LECTOR DE NOTAS Y REDACCIÓN AUTOMÁTICA)
           ========================================================= */
        .modal-backdrop {
            position: fixed;
            inset: 0;
            background-color: rgba(20, 19, 17, 0.72);
            display: none;
            align-items: center;
            justify-content: center;
            padding: 16px;
            z-index: 100;
            overflow-y: auto;
        }

        .modal-backdrop.open {
            display: flex;
        }

        .modal-dialog {
            background-color: var(--paper-bg);
            color: var(--ink-main);
            width: 100%;
            max-width: 760px;
            max-height: 90vh;
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-lg);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .modal-header {
            background-color: var(--paper-alt);
            padding: 14px 20px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .reader-tools {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .tool-btn {
            background-color: var(--paper-card);
            border: 1px solid var(--border-color);
            color: var(--ink-main);
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 0.82rem;
            font-weight: 700;
            cursor: pointer;
        }

        .tool-btn:hover {
            background-color: var(--ink-main);
            color: #FFFFFF;
        }

        .tool-btn.saved {
            background-color: var(--gold);
            color: #FFFFFF;
            border-color: var(--gold);
        }

        .btn-close-modal {
            background-color: var(--burgundy);
            color: #FFFFFF;
            border: none;
            padding: 6px 14px;
            border-radius: 8px;
            font-size: 0.84rem;
            font-weight: 700;
            cursor: pointer;
        }

        .modal-scroll {
            padding: 24px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .article-full-title {
            font-family: var(--font-serif);
            font-size: clamp(1.5rem, 3vw, 2.15rem);
            font-weight: 900;
            line-height: 1.18;
        }

        .article-full-subtitle {
            font-size: 1.05rem;
            color: var(--ink-muted);
            font-weight: 500;
        }

        .article-paragraphs {
            display: flex;
            flex-direction: column;
            gap: 14px;
            font-size: 1.08rem;
            line-height: 1.75;
            color: var(--ink-main);
        }

        /* Formulario de Redacción Automática */
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
            margin-bottom: 12px;
        }

        .form-group label {
            font-size: 0.82rem;
            font-weight: 700;
            color: var(--ink-main);
        }

        .form-control {
            background-color: var(--paper-card);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 9px 12px;
            font-size: 0.92rem;
            color: var(--ink-main);
            width: 100%;
        }

        .queue-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 10px;
        }

        .queue-item {
            background-color: var(--paper-card);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 12px 14px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        /* =========================================================
           9. TOAST DE NOTIFICACIÓN SUAVE Y PIE DE PÁGINA
           ========================================================= */
        .toast-banner {
            position: fixed;
            bottom: 20px;
            right: 20px;
            left: 20px;
            max-width: 420px;
            margin-left: auto;
            background-color: var(--ink-main);
            color: #FAF7F2;
            border-left: 5px solid #22C55E;
            padding: 14px 16px;
            border-radius: 12px;
            box-shadow: var(--shadow-lg);
            display: none;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            z-index: 120;
            cursor: pointer;
        }

        .toast-banner.show {
            display: flex;
            animation: cardSlideIn 0.35s ease;
        }

        .site-footer {
            background-color: var(--ink-main);
            color: #D6D0C4;
            padding: 32px 0;
            border-top: 4px solid var(--burgundy);
            font-size: 0.88rem;
        }

        .footer-inner {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 20px;
        }

        /* =========================================================
           10. RESPONSIVE MOBILE-FIRST
           ========================================================= */
        @media (max-width: 820px) {
            .hero-card {
                grid-template-columns: 1fr;
            }
            .hero-art {
                min-height: 200px;
            }
            .hero-body {
                padding: 20px;
            }
            .masthead-grid {
                justify-content: center;
                text-align: center;
            }
            .search-box {
                width: 100%;
            }
        }
    </style>
</head>
<body>

    <!-- 1. BARRA SUPERIOR EN VIVO Y CONTROL DE AUTO-PUBLICACIÓN -->
    <div class="top-live-bar">
        <div class="top-live-inner">
            <div class="live-meta">
                <span id="live-badge" class="live-badge">
                    <span class="pulse-dot"></span>
                    <span id="live-badge-label">EN VIVO · PUBLICACIÓN AUTOMÁTICA</span>
                </span>
                <span id="header-date">Edición del Día · Buenos Aires, Argentina</span>
            </div>

            <div class="auto-controls">
                <div class="countdown-box">
                    Próxima nota en: <strong id="countdown-seconds">15s</strong>
                </div>
                <button type="button" class="btn-top btn-publish-now" onclick="publishNextNow()">
                    ⚡ Publicar ahora
                </button>
                <button type="button" id="btn-toggle-auto" class="btn-top btn-pause" onclick="toggleAutoPublish()">
                    ⏸ Pausar
                </button>
            </div>
        </div>
    </div>

    <!-- 2. CABECERA TIPO PERIÓDICO CLÁSICO -->
    <header class="masthead">
        <div class="container">
            <div class="masthead-grid">
                <div class="edition-info">
                    <div>Año XCIV · N° 34.812</div>
                    <div id="total-published-label">6 noticias publicadas</div>
                </div>

                <div class="brand-center">
                    <div class="brand-kicker">El diario de la familia · Claro, confiable y al instante</div>
                    <h1 class="brand-title">Las Noticias del Abuelo</h1>
                    <p class="brand-subtitle">“Para leer con el mate caliente y entender lo que pasa en el país y el mundo”</p>
