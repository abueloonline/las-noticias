                var next = publishQueue.length > 0 ? publishQueue.shift() : createFallbackArticle();
                publishArticleObject(next);
            };

            window.publishSpecificFromQueue = function (index) {
                if (index < 0 || index >= publishQueue.length) return;
                var picked = publishQueue.splice(index, 1)[0];
                publishArticleObject(picked);
            };

