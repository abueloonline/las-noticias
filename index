                for (var i = 0; i < articles.length; i++) {
                    if (articles[i].id === id) {
                        found = articles[i];
                        break;
                    }
                }
                if (!found) return;

                activeArticleId = found.id;
                found.isNew = false;

                var catBadge = document.getElementById("modal-cat-badge");
                catBadge.textContent = found.category;
                catBadge.className = "cat-pill " + getCategoryClass(found.category);

                document.getElementById("modal-meta-info").textContent = found.author + " · " + found.readTime + " · " + found.timeLabel;
                document.getElementById("modal-article-title").textContent = found.title;
                document.getElementById("modal-article-subtitle").textContent = found.excerpt;
                document.getElementById("modal-grandpa-quote").textContent = "“El apunte del Abuelo: " + found.grandpaQuote + "”";
                document.getElementById("modal-art-box").innerHTML = buildArtworkSVG(found.category, true);

                var bodyEl = document.getElementById("modal-article-body");
                bodyEl.style.fontSize = fontSizes[fontIndex];
                var pHtml = "";
                for (var j = 0; j < found.paragraphs.length; j++) {
                    pHtml += "<p>" + escapeHTML(found.paragraphs[j]) + "</p>";
                }
                bodyEl.innerHTML = pHtml;

                updateModalSaveButton();
                document.getElementById("reader-modal").classList.add("open");
                renderPortal();
            };

            window.openHeroArticle = function () {
                if (articles.length > 0) {
                    window.openArticleModal(articles[0].id);
                }
            };

            window.openLatestPublishedArticle = function () {
                var toast = document.getElementById("toast-banner");
                if (toast) toast.classList.remove("show");
                window.openArticleModal(latestPublishedId);
            };

            window.closeReaderModal = function () {
                document.getElementById("reader-modal").classList.remove("open");
            };

            window.changeFontSize = function (delta) {
                fontIndex = Math.max(0, Math.min(fontSizes.length - 1, fontIndex + delta));
                var bodyEl = document.getElementById("modal-article-body");
                if (bodyEl) bodyEl.style.fontSize = fontSizes[fontIndex];
            };

            function updateModalSaveButton() {
                var btn = document.getElementById("modal-save-btn");
                if (!btn || activeArticleId === null) return;
                var isSaved = savedIds.indexOf(activeArticleId) !== -1;
                btn.textContent = isSaved ? "★ Nota guardada" : "☆ Guardar nota";
                if (isSaved) btn.classList.add("saved");
                else btn.classList.remove("saved");
            }

            window.toggleSaveCurrentArticle = function () {
                if (activeArticleId === null) return;
                var idx = savedIds.indexOf(activeArticleId);
                if (idx === -1) {
                    savedIds.push(activeArticleId);
                } else {
                    savedIds.splice(idx, 1);
                }
                updateModalSaveButton();
                updateCounters();
                if (onlySaved) renderPortal();
            };

            window.openQueueModal = function () {
                renderQueueList();
                document.getElementById("queue-modal").classList.add("open");
            };

            window.closeQueueModal = function () {
                document.getElementById("queue-modal").classList.remove("open");
            };

            window.closeModalOnBackdrop = function (event, modalId) {
                if (event.target && event.target.id === modalId) {
                    document.getElementById(modalId).classList.remove("open");
                }
            };

            window.submitCustomArticle = function (event) {
                event.preventDefault();
                var cat = document.getElementById("new-art-category").value;
                var title = document.getElementById("new-art-title").value.trim();
                var summary = document.getElementById("new-art-summary").value.trim();
                if (!title || !summary) return;

                var paragraphs = summary.split(/\n+/).filter(function (line) {
                    return line.trim().length > 0;
                });

                publishArticleObject({
                    id: Date.now(),
                    category: cat,
                    title: title,
                    excerpt: paragraphs[0],
                    author: "Por Redacción del Abuelo · Edición Especial",
                    readTime: "3 min de lectura",
                    grandpaQuote: "Una buena noticia compartida a tiempo siempre alegra la jornada.",
                    paragraphs: paragraphs
                });

                document.getElementById("new-art-title").value = "";
                document.getElementById("new-art-summary").value = "";
                window.closeQueueModal();
            };

            // Inicialización segura tanto inmediata como en DOMContentLoaded
            function initApp() {
                try {
                    setFormattedDate();
                    renderPortal();
                    renderQueueList();
                    startAutoTimer();
                } catch (err) {
                    console.error("Error inicializando Las Noticias del Abuelo:", err);
                }
            }

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", initApp);
            } else {
                initApp();
            }
        })();
    </script>
</body>
</html>
